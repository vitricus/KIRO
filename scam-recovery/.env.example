# Which phone lookup to use: "mock" (default, demo data) or "http"
PHONE_LOOKUP_PROVIDER=mock
# Only for "http". See lib/services/phone/http.ts to adapt to your vendor's response.
PHONE_LOOKUP_URL=
PHONE_LOOKUP_API_KEY=
# Assumed country code for numbers typed without a "+"
DEFAULT_COUNTRY_CODE=1

# Which Gmail service to use: "mock" (default) or "google"
GMAIL_PROVIDER=mock
